<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="NutritionApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:NutritionApp.Views"
    xmlns:behaviors="clr-namespace:NutritionApp.Behaviors"
    Shell.FlyoutBehavior="Disabled"
    Shell.TabBarIsVisible="False"
    Shell.BackgroundColor="#0F111F">

    <Shell.Behaviors>
        <behaviors:FloatingTabBarShellBehavior />
    </Shell.Behaviors>

    <ShellContent
        Title="Вхід"
        ContentTemplate="{DataTemplate local:LoginPage}"
        Route="LoginPage" />

    <TabBar Route="MainApp" Shell.TabBarIsVisible="False">
        <ShellContent
            Title="Головна"
            Route="MainPage"
            Icon="home_silhouette.png" 
            ContentTemplate="{DataTemplate local:MainPage}" />

        <ShellContent
            Title="Раціон"
            Route="MealPlanPage"
            Icon="restaurant_icon.png" 
            ContentTemplate="{DataTemplate local:MealPlanPage}" />

        <ShellContent
            Title="Рецепти"
            Route="SavedRecipesPage"
            Icon="history_icon.png" 
            ContentTemplate="{DataTemplate local:SavedRecipesPage}" />

        <ShellContent
            Title="Рейтинг"
            Route="LeaderboardPage"
            Icon="history_icon.png" 
            ContentTemplate="{DataTemplate local:LeaderboardPage}" />

        <ShellContent
            Title="Профіль"
            Route="ProfilePage"
            Icon="avatar_icon.png" 
            ContentTemplate="{DataTemplate local:ProfilePage}" />

    </TabBar>

</Shell>