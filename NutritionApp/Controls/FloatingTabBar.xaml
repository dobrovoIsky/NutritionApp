<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NutritionApp.Controls.FloatingTabBar"
             HorizontalOptions="Center"
             VerticalOptions="End"
             Margin="24,0,24,20"
             InputTransparent="False"
             HeightRequest="52">

    <Border x:Name="DockShell"
            StrokeShape="RoundRectangle 22"
            StrokeThickness="1"
            Stroke="{StaticResource DockBorderBrush}"
            Background="{StaticResource DockBackgroundBrush}"
            Padding="4,4"
            HorizontalOptions="Center"
            VerticalOptions="End">

        <Border.Shadow>
            <Shadow Brush="#000000" Offset="0,4" Radius="12" Opacity="0.35" />
        </Border.Shadow>

        <HorizontalStackLayout x:Name="TabsHost"
                               Spacing="2"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
    </Border>
</ContentView>
