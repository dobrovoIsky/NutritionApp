<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NutritionApp.Views.WorkoutPage"
             Shell.NavBarIsVisible="False"
             Background="{StaticResource PageBackgroundGradient}">

    <Grid RowDefinitions="Auto,*" Padding="16,20,16,0">

        <!-- Header -->
        <Grid Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,24">
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                <Label Text="Персоналізоване тренування" FontSize="14" TextColor="{StaticResource TextSecondary}" />
                <Label Text="Тренування" FontAttributes="Bold" FontSize="32" TextColor="{StaticResource TextPrimary}" />
            </VerticalStackLayout>
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never" Padding="0,0,0,40">
            <VerticalStackLayout Spacing="20">

                <!-- Вибір типу тренування -->
                <Label Text="Обери тип" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" Margin="0,8,0,0"/>

                <!-- 3 карточки вибору типу -->
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" RowSpacing="12" ColumnSpacing="12">

                    <!-- Кардіо -->
                    <Border x:Name="CardioCard" Style="{StaticResource ActiveGlowBorder}" BackgroundColor="{StaticResource CardBackground}" Padding="16" HeightRequest="130">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCardioTapped"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="6" VerticalOptions="Center" HorizontalOptions="Center">
                            <Label Text="🏃" FontSize="32" HorizontalOptions="Center"/>
                            <Label Text="Кардіо" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center"/>
                            <Label Text="Біг, скакалка" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center"/>
                            <Label Text="Обрати" FontSize="12" TextColor="{StaticResource Primary}" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,4,0,0"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Силове в залі -->
                    <Border x:Name="GymCard" Grid.Column="1" Style="{StaticResource ActiveGlowBorder}" BackgroundColor="{StaticResource CardBackground}" Padding="16" HeightRequest="130">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGymTapped"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="6" VerticalOptions="Center" HorizontalOptions="Center">
                            <Label Text="🏋️" FontSize="32" HorizontalOptions="Center"/>
                            <Label Text="В залі" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center"/>
                            <Label Text="Тренажери, штанга" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center"/>
                            <Label Text="Обрати" FontSize="12" TextColor="{StaticResource Primary}" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,4,0,0"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Тренування вдома -->
                    <Border x:Name="HomeCard" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource ActiveGlowBorder}" BackgroundColor="{StaticResource CardBackground}" Padding="16" HeightRequest="90">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnHomeTapped"/>
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                            <Label Text="🏠" FontSize="32" VerticalOptions="Center" Margin="0,0,16,0"/>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="Вдома" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                                <Label Text="Без обладнання, власна вага" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="Обрати" FontSize="13" TextColor="{StaticResource Primary}" FontAttributes="Bold" VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Кнопка вибору обладнання (видима тільки для gym) -->
                <Border x:Name="EquipmentContainer" IsVisible="False" Style="{StaticResource ActiveGlowBorder}" BackgroundColor="{StaticResource CardBackground}" Padding="16">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnEquipmentClicked"/>
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 22" BackgroundColor="#4C1D95" StrokeThickness="0">
                            <Label Text="🏋️" FontSize="20" VerticalOptions="Center" HorizontalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label x:Name="EquipmentButtonLabel" Text="Обрати обладнання" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                            <Label Text="Вибір тренажерів в залі" FontSize="13" TextColor="{StaticResource TextSecondary}"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="→" FontSize="20" TextColor="{StaticResource Primary}" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- Тривалість -->
                <Border Style="{StaticResource ActiveGlowBorder}" BackgroundColor="{StaticResource CardBackground}" Padding="16">
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 22" BackgroundColor="#2A1010" StrokeThickness="0">
                                <Label Text="⏱️" FontSize="20" VerticalOptions="Center" HorizontalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="Тривалість тренування" FontSize="13" TextColor="{StaticResource TextSecondary}"/>
                                <Label x:Name="DurationLabel" Text="45 хвилин" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                            </VerticalStackLayout>
                        </Grid>
                        <Slider x:Name="DurationSlider" Minimum="15" Maximum="90" Value="45" ValueChanged="OnDurationChanged" MinimumTrackColor="{StaticResource Primary}" MaximumTrackColor="{StaticResource BorderColor}" ThumbColor="{StaticResource Primary}"/>
                        <Grid ColumnDefinitions="*,*,*">
                            <Label Text="15 хв" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Start"/>
                            <Label Grid.Column="1" Text="45 хв" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center"/>
                            <Label Grid.Column="2" Text="90 хв" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="End"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Кнопка генерації -->
                <Button x:Name="GenerateButton" Text="Згенерувати" Style="{StaticResource AccentButton}" Clicked="OnGenerateClicked" HeightRequest="54" CornerRadius="27" FontAttributes="Bold" FontSize="16" Margin="0,8,0,0" />

                <!-- Індикатор завантаження -->
                <VerticalStackLayout x:Name="LoadingContainer" IsVisible="False" Spacing="16" HorizontalOptions="Center" Margin="0,30,0,0">
                    <ActivityIndicator IsRunning="True" Color="{StaticResource Primary}" HeightRequest="40" WidthRequest="40"/>
                    <Label Text="AI створює твоє тренування..." FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center"/>
                    <Label Text="Це може зайняти до 30 секунд" FontSize="14" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Результат тренування -->
                <VerticalStackLayout x:Name="ResultContainer" IsVisible="False" Spacing="20" Margin="0,16,0,0">

                    <!-- Summary -->
                    <Label x:Name="SummaryLabel" FontSize="15" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center"/>

                    <!-- Інфо-блоки -->
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <Border Style="{StaticResource ActiveGlowBorder}" BackgroundColor="{StaticResource CardBackground}" Padding="12">
                            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Label x:Name="TypeIcon" Text="🏃" FontSize="22" HorizontalOptions="Center"/>
                                <Label x:Name="TypeLabel" Text="Кардіо" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource ActiveGlowBorder}" BackgroundColor="{StaticResource CardBackground}" Padding="12">
                            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Label Text="⏱️" FontSize="22" HorizontalOptions="Center"/>
                                <Label x:Name="DurationResultLabel" Text="45 хв" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource ActiveGlowBorder}" BackgroundColor="{StaticResource CardBackground}" Padding="12">
                            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Label Text="🔥" FontSize="22" HorizontalOptions="Center"/>
                                <Label x:Name="CaloriesLabel" Text="~300 ккал" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Primary}" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Розминка -->
                    <Border x:Name="WarmupContainer" Style="{StaticResource ActiveGlowBorder}" BackgroundColor="{StaticResource CardBackground}" Padding="16">
                        <VerticalStackLayout Spacing="10">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="🔥" FontSize="18"/>
                                <Label Text="Розминка" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                                <Label x:Name="WarmupDurationLabel" Text="5 хв" FontSize="14" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Label x:Name="WarmupExercisesLabel" FontSize="14" TextColor="{StaticResource TextSecondary}" LineHeight="1.4"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Вправи -->
                    <Label Text="Основна частина" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" Margin="0,8,0,0"/>

                    <VerticalStackLayout x:Name="ExercisesContainer" Spacing="12">
                        <!-- Вправи будуть додані динамічно -->
                    </VerticalStackLayout>

                    <!-- Заминка -->
                    <Border x:Name="CooldownContainer" Style="{StaticResource ActiveGlowBorder}" BackgroundColor="{StaticResource CardBackground}" Padding="16" Margin="0,8,0,0">
                        <VerticalStackLayout Spacing="10">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="🧘" FontSize="18"/>
                                <Label Text="Заминка" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                                <Label x:Name="CooldownDurationLabel" Text="5 хв" FontSize="14" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Label x:Name="CooldownExercisesLabel" FontSize="14" TextColor="{StaticResource TextSecondary}" LineHeight="1.4"/>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>

                <!-- Початкове повідомлення -->
                <VerticalStackLayout x:Name="InitialMessage" Spacing="16" HorizontalOptions="Center" Margin="0,40,0,0">
                    <Label Text="👆" FontSize="44" HorizontalOptions="Center"/>
                    <Label Text="Обери тип тренування вище" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>