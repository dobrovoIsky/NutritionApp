<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NutritionApp.Views.WorkoutDetailPage"
             Shell.NavBarIsVisible="False"
             Background="{DynamicResource PageBackgroundGradient}">

    <Grid RowDefinitions="Auto,*" Padding="16,20,16,0">
        <!-- Header -->
        <Grid Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,24">
            <Border WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 20"
                    BackgroundColor="#FFFFFF22" Stroke="White" StrokeThickness="1"
                    HorizontalOptions="Start" VerticalOptions="Center" Margin="0,0,16,0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackClicked"/>
                </Border.GestureRecognizers>
                <Label Text="‹" FontSize="28" TextColor="White" VerticalOptions="Center" HorizontalOptions="Center" TranslationY="-2"/>
            </Border>

            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                <Label x:Name="GoalLabel" FontSize="14" TextColor="{StaticResource TextSecondary}" />
                <Label Text="Деталі тренування" FontAttributes="Bold" FontSize="32" TextColor="{StaticResource TextPrimary}" />
            </VerticalStackLayout>
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never" Padding="0,0,0,40">
            <VerticalStackLayout x:Name="ContentContainer" Spacing="16">
                <!-- Dynamic Content -->
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
