<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:NutritionApp.ViewModels"
             xmlns:converters="clr-namespace:NutritionApp.Converters"
             x:Class="NutritionApp.Views.ProfilePage"
             x:DataType="viewmodels:ProfileViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundImageSource="app_background_img.png">

    <ContentPage.Resources>
        <converters:Base64ToImageSourceConverter x:Key="Base64Converter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" Padding="16,20,16,0">

        <!-- Header -->
        <Grid Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,24">
            <Border WidthRequest="90" HeightRequest="90" StrokeShape="RoundRectangle 45"
                    BackgroundColor="#FFFFFF22" Stroke="White" StrokeThickness="2"
                    HorizontalOptions="Start" VerticalOptions="Center">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.2"/>
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding PickAvatarCommand}"/>
                </Border.GestureRecognizers>
                
                <Grid>
                    <!-- Fallback Label -->
                    <Label Text="{Binding AvatarInitial}" 
                           IsVisible="{Binding HasAvatar, Converter={StaticResource InvertedBoolConverter}}"
                           TextColor="White" FontAttributes="Bold" FontSize="40" 
                           HorizontalOptions="Center" VerticalOptions="Center"
                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                    
                    <!-- Base64 Image -->
                    <Image x:Name="AvatarImage"
                           WidthRequest="90" HeightRequest="90"
                           Source="{Binding UserProfile.AvatarBase64, Converter={StaticResource Base64Converter}}"
                           IsVisible="{Binding HasAvatar}"
                           Aspect="AspectFill"
                           HorizontalOptions="Fill" VerticalOptions="Fill" />
                </Grid>
            </Border>
            
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="16,0,0,0">
                <Label Text="Твій профіль" FontSize="14" TextColor="{StaticResource TextSecondary}" />
                <Label x:Name="UsernameLabel" Text="{Binding UserProfile.Username, StringFormat='{0}'}" FontAttributes="Bold" FontSize="32" TextColor="{StaticResource TextPrimary}" />
                <HorizontalStackLayout Spacing="15" Margin="0,5,0,0">
                    <HorizontalStackLayout Spacing="4">
                        <Image Source="diamond.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" />
                        <Label Text="{Binding UserProfile.Balance}" TextColor="{StaticResource AccentColor}" FontAttributes="Bold" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="4">
                        <Image Source="xp.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" />
                        <Label Text="{Binding UserProfile.MonthlyPoints, StringFormat='{0} XP'}" TextColor="#FFD700" FontAttributes="Bold" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="4">
                        <Image Source="strik.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" />
                        <Label Text="{Binding UserProfile.CurrentStreak, StringFormat='{0} дн.'}" TextColor="#FF9500" FontAttributes="Bold" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never" Padding="0,0,0,40">
            <VerticalStackLayout Spacing="20">

                <!-- Кнопки дій -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                    <Button ImageSource="edit.png" Text="Редагувати"
                            Clicked="OnEditProfileClicked"
                            Style="{StaticResource AccentButton}"
                            HeightRequest="52"
                            CornerRadius="26"
                            FontAttributes="Bold"
                            FontSize="15"/>

                    <Button Grid.Column="1"
                            ImageSource="signout.png"
                            Text="Вийти"
                            Clicked="OnLogoutButtonClicked"
                            HeightRequest="52"
                            CornerRadius="26"
                            BackgroundColor="#22FFFFFF"       
                            TextColor="White"
                            BorderColor="#44FFFFFF"
                            BorderWidth="1"
                            FontAttributes="Bold"
                            FontSize="15"/>
                </Grid>

                <Label Text="Мої показники" FontSize="22" FontAttributes="Bold" TextColor="White" Margin="0,16,0,8"/>

                <!-- Блок з основними даними -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="15" ColumnSpacing="15">
                    
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource ActiveGlowBorder}" BackgroundColor="{StaticResource CardBackground}" Padding="20">
                        <VerticalStackLayout Spacing="8">
                            <HorizontalStackLayout Spacing="8">
                                <Image Source="height.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center"/>
                                <Label Text="Ріст" FontSize="14" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Label Text="{Binding UserProfile.Height, StringFormat='{0:F1} см'}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource ActiveGlowBorder}" BackgroundColor="{StaticResource CardBackground}" Padding="20">
                        <VerticalStackLayout Spacing="8">
                            <HorizontalStackLayout Spacing="8">
                                <Image Source="weight.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center"/>
                                <Label Text="Вага" FontSize="14" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Label Text="{Binding UserProfile.Weight, StringFormat='{0:F1} кг'}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ActiveGlowBorder}" BackgroundColor="{StaticResource CardBackground}" Padding="20">
                        <VerticalStackLayout Spacing="8">
                            <HorizontalStackLayout Spacing="8">
                                <Image Source="age.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center"/>
                                <Label Text="Вік" FontSize="14" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Label Text="{Binding UserProfile.Age, StringFormat='{0} років'}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource ActiveGlowBorder}" BackgroundColor="{StaticResource CardBackground}" Padding="20">
                        <VerticalStackLayout Spacing="8">
                            <HorizontalStackLayout Spacing="8">
                                <Image Source="activity.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center"/>
                                <Label Text="Активність" FontSize="14" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Label Text="{Binding ActivityLevelUa}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Primary}" LineBreakMode="TailTruncation" VerticalOptions="Center" HeightRequest="30"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource ActiveGlowBorder}" BackgroundColor="{StaticResource CardBackground}" Padding="20">
                        <VerticalStackLayout Spacing="8">
                            <HorizontalStackLayout Spacing="8">
                                <Image Source="goal.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center"/>
                                <Label Text="Ціль" FontSize="14" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Label Text="{Binding GoalUa}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Label Text="Налаштування" FontSize="22" FontAttributes="Bold" TextColor="White" Margin="0,24,0,8"/>

                <!-- Нагадування про воду -->
                <Border Style="{StaticResource ActiveGlowBorder}" BackgroundColor="{StaticResource CardBackground}" Padding="16">
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                            <Border WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 22" BackgroundColor="#1E3A8A" StrokeThickness="0">
                                <Label Text="💧" FontSize="20" VerticalOptions="Center" HorizontalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0" VerticalOptions="Center">
                                <Label Text="Нагадування про воду" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                                <Label Text="Сповіщення пити воду" FontSize="13" TextColor="{StaticResource TextSecondary}"/>
                            </VerticalStackLayout>
                            <Switch x:Name="WaterReminderSwitch" Grid.Column="2" Toggled="OnWaterReminderToggled" VerticalOptions="Center"/>
                        </Grid>

                        <Border x:Name="IntervalPickerContainer" IsVisible="False" Stroke="{StaticResource BorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource PageBackground}" Padding="12">
                            <VerticalStackLayout Spacing="12">
                                <Picker x:Name="IntervalPicker" Title="Інтервал нагадувань" SelectedIndexChanged="OnIntervalChanged" TextColor="{StaticResource TextPrimary}" TitleColor="{StaticResource TextSecondary}">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String>Кожні 30 хвилин</x:String>
                                            <x:String>Кожні 45 хвилин</x:String>
                                            <x:String>Кожні 60 хвилин</x:String>
                                            <x:String>Кожні 90 хвилин</x:String>
                                            <x:String>Кожні 2 години</x:String>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>

                                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12" Margin="0,4,0,0">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="Start Time" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                                        <Border Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource CardBackground}" Padding="8,0" HeightRequest="40">
                                            <TimePicker Time="{Binding WaterStartTime}" Format="HH:mm" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                                        </Border>
                                    </VerticalStackLayout>
                                    
                                    <Label Text="—" Grid.Column="1" VerticalOptions="Center" Margin="0,18,0,0" TextColor="{StaticResource TextSecondary}"/>

                                    <VerticalStackLayout Grid.Column="2" Spacing="4">
                                        <Label Text="End Time" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                                        <Border Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource CardBackground}" Padding="8,0" HeightRequest="40">
                                            <TimePicker Time="{Binding WaterEndTime}" Format="HH:mm" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
