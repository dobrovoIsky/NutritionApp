<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NutritionApp.Views.LoginPage"
             Shell.NavBarIsVisible="False"
             Background="{StaticResource PageBackgroundGradient}">

    <ScrollView VerticalScrollBarVisibility="Never">
        <Grid RowDefinitions="Auto,Auto,*" Padding="16,40,16,0" MinimumHeightRequest="700">

            <!-- Верхній блок -->
            <Grid Grid.Row="0" Margin="0,0,0,40">
                <VerticalStackLayout Spacing="16" VerticalOptions="Center" HorizontalOptions="Center">
                    <Image Source="logo.png" HeightRequest="120" WidthRequest="120" Aspect="AspectFit" HorizontalOptions="Center"/>
                    <Label Text="TrackBite" FontAttributes="Bold" FontSize="32" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center"/>
                    <Label Text="Увійди, щоб продовжити" FontSize="16" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>

            <!-- Карта форми -->
            <VerticalStackLayout Grid.Row="1" Spacing="24">

                <!-- Username -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Email" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" Margin="4,0,0,0"/>
                    <Border Style="{StaticResource ActiveGlowBorder}" BackgroundColor="{StaticResource CardBackground}" Padding="16,8">
                        <Entry x:Name="UsernameEntry" Placeholder="hello@trackbite.app" Keyboard="Email" TextColor="{StaticResource TextPrimary}" PlaceholderColor="{StaticResource TextSecondary}" BackgroundColor="Transparent" />
                    </Border>
                </VerticalStackLayout>

                <!-- Password -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Пароль" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" Margin="4,0,0,0"/>
                    <Border Style="{StaticResource ActiveGlowBorder}" BackgroundColor="{StaticResource CardBackground}" Padding="16,8">
                        <Entry x:Name="PasswordEntry" Placeholder="Пароль (мін. 8 символів)" IsPassword="True" TextColor="{StaticResource TextPrimary}" PlaceholderColor="{StaticResource TextSecondary}" BackgroundColor="Transparent" />
                    </Border>
                    <Label Text="Забули пароль?" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Primary}" HorizontalOptions="End" Margin="0,4,0,0">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnForgotPasswordClicked"/>
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>

                <!-- Помилка -->
                <Label x:Name="ErrorLabel" TextColor="#EF4444" FontSize="14" FontAttributes="Bold" IsVisible="False" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>

                <!-- Індикатор завантаження -->
                <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" IsVisible="False" Color="{StaticResource Primary}" HorizontalOptions="Center"/>

                <!-- Кнопка входу -->
                <Button Text="Увійти" Clicked="OnLoginButtonClicked" Style="{StaticResource AccentButton}" HeightRequest="56" CornerRadius="28" FontAttributes="Bold" FontSize="18"/>

                <!-- Розділювач -->
                <Grid ColumnDefinitions="*,Auto,*" Margin="0,8,0,8">
                    <BoxView Grid.Column="0" HeightRequest="1" Color="{StaticResource BorderColor}" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="або" FontSize="14" TextColor="{StaticResource TextSecondary}" Margin="16,0"/>
                    <BoxView Grid.Column="2" HeightRequest="1" Color="{StaticResource BorderColor}" VerticalOptions="Center"/>
                </Grid>

                <!-- Кнопка Google -->
                <Border Style="{StaticResource ActiveGlowBorder}" BackgroundColor="{StaticResource CardBackground}" Padding="16">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnGoogleSignInClicked"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="16">
                        <Image Source="google_icon.png" HeightRequest="24" WidthRequest="24" VerticalOptions="Center"/>
                        <Label Text="Продовжити з Google" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

            </VerticalStackLayout>

            <!-- Перейти до реєстрації -->
            <HorizontalStackLayout Grid.Row="2" HorizontalOptions="Center" VerticalOptions="End" Spacing="6" Margin="0,0,0,40">
                <Label Text="Ще не маєш акаунту?" FontSize="15" TextColor="{StaticResource TextSecondary}"/>
                <Label Text="Зареєструватися" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Primary}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnGoToRegisterClicked"/>
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </Grid>
    </ScrollView>
</ContentPage>