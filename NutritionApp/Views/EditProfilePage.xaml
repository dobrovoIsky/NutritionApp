<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NutritionApp.Views.EditProfilePage"
             Title="Редагувати профіль"
             Shell.NavBarIsVisible="False"
             Background="{StaticResource PageBackgroundGradient}">

    <Grid RowDefinitions="Auto,*" Padding="16,20,16,0">

        <!-- Header -->
        <Grid Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,24">
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                <Label Text="Твої дані" FontSize="14" TextColor="{StaticResource TextSecondary}" />
                <Label Text="Редагувати профіль" FontAttributes="Bold" FontSize="32" TextColor="{StaticResource TextPrimary}" />
            </VerticalStackLayout>
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never" Padding="0,0,0,40">
            <VerticalStackLayout Spacing="24">

                <Label Text="Особиста інформація" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" Margin="0,0,0,-8"/>

                <Border Style="{StaticResource ActiveGlowBorder}" BackgroundColor="{StaticResource CardBackground}" Padding="16">
                    <VerticalStackLayout Spacing="16">
                        
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Ім'я користувача" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" Margin="4,0,0,0"/>
                            <Border Style="{StaticResource ActiveGlowBorder}" BackgroundColor="{StaticResource PageBackground}" Padding="16,8" StrokeThickness="0">
                                <Entry Text="{Binding UserProfile.Username}" Placeholder="Введіть ім'я" BackgroundColor="Transparent" TextColor="{StaticResource TextPrimary}" PlaceholderColor="{StaticResource TextSecondary}"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Зріст (см)" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" Margin="4,0,0,0"/>
                            <Border Style="{StaticResource ActiveGlowBorder}" BackgroundColor="{StaticResource PageBackground}" Padding="16,8" StrokeThickness="0">
                                <Entry Text="{Binding UserProfile.Height}" Keyboard="Numeric" Placeholder="170" BackgroundColor="Transparent" TextColor="{StaticResource TextPrimary}" PlaceholderColor="{StaticResource TextSecondary}"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Вага (кг)" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" Margin="4,0,0,0"/>
                            <Border Style="{StaticResource ActiveGlowBorder}" BackgroundColor="{StaticResource PageBackground}" Padding="16,8" StrokeThickness="0">
                                <Entry Text="{Binding UserProfile.Weight}" Keyboard="Numeric" Placeholder="70" BackgroundColor="Transparent" TextColor="{StaticResource TextPrimary}" PlaceholderColor="{StaticResource TextSecondary}"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Вік" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" Margin="4,0,0,0"/>
                            <Border Style="{StaticResource ActiveGlowBorder}" BackgroundColor="{StaticResource PageBackground}" Padding="16,8" StrokeThickness="0">
                                <Entry Text="{Binding UserProfile.Age}" Keyboard="Numeric" Placeholder="25" BackgroundColor="Transparent" TextColor="{StaticResource TextPrimary}" PlaceholderColor="{StaticResource TextSecondary}"/>
                            </Border>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <Label Text="Налаштування" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" Margin="0,0,0,-8"/>

                <Border Style="{StaticResource ActiveGlowBorder}" BackgroundColor="{StaticResource CardBackground}" Padding="16">
                    <VerticalStackLayout Spacing="16">

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Ціль" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" Margin="4,0,0,0"/>
                            <Border Style="{StaticResource ActiveGlowBorder}" BackgroundColor="{StaticResource PageBackground}" Padding="4,0" StrokeThickness="0">
                                <Picker SelectedItem="{Binding SelectedGoal}" TextColor="{StaticResource TextPrimary}" Title="Оберіть ціль">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String>Схуднення</x:String>
                                            <x:String>Набір маси</x:String>
                                            <x:String>Підтримка ваги</x:String>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Рівень активності" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" Margin="4,0,0,0"/>
                            <Border Style="{StaticResource ActiveGlowBorder}" BackgroundColor="{StaticResource PageBackground}" Padding="4,0" StrokeThickness="0">
                                <Picker SelectedItem="{Binding SelectedActivityLevel}" TextColor="{StaticResource TextPrimary}" Title="Оберіть рівень активності">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String>Сидячий спосіб життя</x:String>
                                            <x:String>Легка активність</x:String>
                                            <x:String>Помірна активність</x:String>
                                            <x:String>Висока активність</x:String>
                                            <x:String>Дуже висока активність</x:String>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Стать" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" Margin="4,0,0,0"/>
                            <Border Style="{StaticResource ActiveGlowBorder}" BackgroundColor="{StaticResource PageBackground}" Padding="4,0" StrokeThickness="0">
                                <Picker SelectedItem="{Binding SelectedGender}" TextColor="{StaticResource TextPrimary}" Title="Оберіть стать">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String>Чоловіча</x:String>
                                            <x:String>Жіноча</x:String>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>
                            </Border>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <Button Text="Зберегти зміни" Command="{Binding SaveCommand}" Style="{StaticResource AccentButton}" HeightRequest="56" CornerRadius="28" FontAttributes="Bold" FontSize="18" Margin="0,16,0,0"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>