<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:NutritionApp.Converters"
             xmlns:viewModels="clr-namespace:NutritionApp.ViewModels"
             x:Class="NutritionApp.Views.MealPlanPage"
             Shell.NavBarIsVisible="False"
             Background="{StaticResource PageBackgroundGradient}">

    <!-- Resources ПЕРЕД контентом -->
    <ContentPage.Resources>
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
    </ContentPage.Resources>

    <!-- Контент сторінки -->
    <Grid RowDefinitions="Auto,*" Padding="16,20,16,0">

        <!-- Header -->
        <Grid Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,24">
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                <Label Text="Персоналізований раціон від AI" FontSize="14" TextColor="{StaticResource TextSecondary}" />
                <Label Text="План харчування" FontAttributes="Bold" FontSize="32" TextColor="{StaticResource TextPrimary}" />
            </VerticalStackLayout>
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,*">

            <Border Grid.Row="0" Style="{StaticResource ActiveGlowBorder}" BackgroundColor="{StaticResource CardBackground}" Padding="16" Margin="0,0,0,12">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenProductSelectionCommand}"/>
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 22" BackgroundColor="#2A1810" StrokeThickness="0">
                        <Label Text="🛒" FontSize="20" VerticalOptions="Center" HorizontalOptions="Center"/>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="4" Margin="14,0" VerticalOptions="Center">
                        <Label Text="Наявні продукти" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                        <Label Text="{Binding SelectedProductsText}" FontSize="13" TextColor="{StaticResource TextSecondary}"/>
                    </VerticalStackLayout>
                    <Border Grid.Column="2" BackgroundColor="#6366F1" StrokeShape="RoundRectangle 10" Stroke="Transparent" Padding="10,6" IsVisible="{Binding HasSelectedProducts}">
                        <Label Text="{Binding SelectedProductsCount}" FontSize="13" FontAttributes="Bold" TextColor="White"/>
                    </Border>
                    <Label Grid.Column="2" Text="→" FontSize="24" TextColor="{StaticResource Primary}" VerticalOptions="Center" IsVisible="{Binding HasSelectedProducts, Converter={StaticResource InvertedBoolConverter}}"/>
                </Grid>
            </Border>

            <!-- Побажання -->
            <Border Grid.Row="1" Style="{StaticResource ActiveGlowBorder}" BackgroundColor="{StaticResource CardBackground}" Padding="16" Margin="0,0,0,16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Особливі побажання" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                    <Entry Placeholder="Наприклад: без цибулі, тільки вегетаріанське" Text="{Binding PreferencesText}" TextColor="White" PlaceholderColor="{StaticResource TextSecondary}" BackgroundColor="Transparent"/>
                </VerticalStackLayout>
            </Border>

            <!-- Кнопка генерації -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <!-- Звичайна кнопка -->
                <Button x:Name="GenerateBtn" Text="✨ Згенерувати рецепти (💎 10)" 
                        Clicked="OnGenerateClicked"
                        IsVisible="{Binding IsNotLoading}"
                        Style="{StaticResource AccentButton}" 
                        HeightRequest="54" CornerRadius="27" FontAttributes="Bold" FontSize="16"/>
                
                <!-- Стан завантаження -->
                <Border IsVisible="{Binding IsLoading}" 
                        BackgroundColor="#2D2D2D" StrokeThickness="0"
                        HeightRequest="54" StrokeShape="RoundRectangle 27" Padding="0">
                    <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                        <ActivityIndicator IsRunning="{Binding IsLoading}" Color="{StaticResource Primary}" HeightRequest="24" WidthRequest="24"/>
                        <Label Text="Генерується..." TextColor="{StaticResource Primary}" FontAttributes="Bold" FontSize="16" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <!-- Скролюваний контент -->
            <ScrollView Grid.Row="3" VerticalScrollBarVisibility="Never" Padding="0,0,0,72">
                <VerticalStackLayout Spacing="16">

                    <!-- Індикатор завантаження -->
                    <VerticalStackLayout IsVisible="{Binding IsLoading}" Spacing="12" HorizontalOptions="Center" Margin="0,40,0,0">
                        <ActivityIndicator IsRunning="{Binding IsLoading}" Color="{StaticResource Primary}" HeightRequest="40" WidthRequest="40"/>
                        <Label Text="🤖 AI генерує твій план..." FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center"/>
                        <Label Text="Це може зайняти до 30 секунд" FontSize="14" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <!-- Повідомлення про помилку -->
                    <Border IsVisible="{Binding HasError}" Style="{StaticResource ActiveGlowBorder}" BackgroundColor="#450A0A" Padding="16">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="❌ Помилка" FontSize="16" FontAttributes="Bold" TextColor="#DC2626"/>
                            <Label Text="{Binding ErrorMessage}" FontSize="14" TextColor="#991B1B"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Summary -->
                    <Label Text="{Binding Summary}" IsVisible="{Binding HasData}" FontSize="15" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="0,0,0,8"/>

                    <!-- Рецепти -->
                    <CollectionView ItemsSource="{Binding Recipes}" IsVisible="{Binding HasData}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ActiveGlowBorder}" BackgroundColor="{StaticResource CardBackground}" Padding="16" Margin="0,0,0,12">
                                    <VerticalStackLayout Spacing="12">

                                        <!-- Заголовок рецепту -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                                <Label Text="🍽️" FontSize="20"/>
                                                <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                                            </HorizontalStackLayout>
                                            
                                            <HorizontalStackLayout Grid.Column="1" Spacing="8">
                                                <Button Text="💾" Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:MealPlanViewModel}}, Path=SaveRecipeCommand}" CommandParameter="{Binding .}" WidthRequest="40" HeightRequest="40" CornerRadius="20" Padding="0" BackgroundColor="#6366F1" TextColor="White" FontSize="18"/>
                                                <Button Text="+" Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:MealPlanViewModel}}, Path=LogRecipeCommand}" CommandParameter="{Binding .}" WidthRequest="40" HeightRequest="40" CornerRadius="20" Padding="0" BackgroundColor="#10B981" TextColor="White" FontAttributes="Bold" FontSize="22"/>
                                            </HorizontalStackLayout>
                                        </Grid>

                                        <!-- Опис приготування -->
                                        <Label Text="{Binding Description}" FontSize="14" TextColor="{StaticResource TextSecondary}" Margin="0,4,0,8" LineBreakMode="WordWrap"/>

                                        <!-- Список інгредієнтів -->
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Foods}" Spacing="8">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BackgroundColor="{StaticResource PageBackground}" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="14">
                                                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto">
                                                            <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                                                            <Label Grid.Column="1" Text="{Binding Weight}" FontSize="14" Margin="0,0,12,0" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>

                                                            <Button Grid.Column="2" Grid.RowSpan="2" Text="🗑️" Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:MealPlanViewModel}}, Path=RemoveFoodCommand}" CommandParameter="{Binding .}" WidthRequest="44" HeightRequest="44" CornerRadius="22" Padding="0" BackgroundColor="#EF4444" TextColor="White" FontSize="18" VerticalOptions="Center"/>

                                                            <HorizontalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="12" Margin="0,6,0,0">
                                                                <Label Text="{Binding Calories, StringFormat='🔥 {0:F0} ккал'}" FontSize="12" FontAttributes="Bold" TextColor="#EA580C"/>
                                                                <Label Text="{Binding Protein, StringFormat='Б: {0:F1}'}" FontSize="12" TextColor="#16A34A"/>
                                                                <Label Text="{Binding Fat, StringFormat='Ж: {0:F1}'}" FontSize="12" TextColor="#CA8A04"/>
                                                                <Label Text="{Binding Carbs, StringFormat='В: {0:F1}'}" FontSize="12" TextColor="#2563EB"/>
                                                            </HorizontalStackLayout>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>

                                        <!-- Загальні калорії рецепту -->
                                        <Border BackgroundColor="#2A1810" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="10,6" HorizontalOptions="End" Margin="0,4,0,0">
                                            <Label Text="{Binding TotalCalories, StringFormat='Всього: {0:F0} ккал'}" FontSize="13" TextColor="#EA580C" FontAttributes="Bold"/>
                                        </Border>

                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Початкове повідомлення -->
                    <VerticalStackLayout IsVisible="{Binding ShowInitialMessage}" Spacing="16" HorizontalOptions="Center" Margin="0,40,0,0">
                        <Label Text="🥗" FontSize="60" HorizontalOptions="Center"/>
                        <Label Text="Натисни кнопку, щоб згенерувати рецепти" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>