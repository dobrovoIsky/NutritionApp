<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:NutritionApp.ViewModels"
             xmlns:controls="clr-namespace:NutritionApp.Controls"
             x:DataType="viewModels:MainPageViewModel"
             x:Class="NutritionApp.Views.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundImageSource="app_background_img.png">

    <Grid RowDefinitions="Auto,*"
          Padding="16,20,16,0">

        <!-- Top Header: "Hi, Confidency" style -->
        <VerticalStackLayout Grid.Row="0" Spacing="6" Margin="0,0,0,24">
            <Label Text="Твоя норма на сьогодні"
                   FontSize="14"
                   TextColor="{StaticResource TextSecondary}" />
            <Label Text="{Binding UserProfile.Username, StringFormat='Привіт, {0}'}"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}" />
        </VerticalStackLayout>

        <!-- Scrollable Content -->
        <ScrollView Grid.Row="1" BackgroundColor="Transparent" VerticalScrollBarVisibility="Never" Padding="0,0,0,72">
            <VerticalStackLayout Spacing="16" Padding="0,0,0,20">

                <ActivityIndicator IsVisible="{Binding IsLoading}"
                                   IsRunning="{Binding IsLoading}"
                                   Color="{StaticResource Primary}"/>

                <!-- Daily Goal Card (Horizontal Progress) -->
                <Border Style="{StaticResource ActiveGlowBorder}" Padding="20">
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Прогрес калорій"
                                   FontSize="16"
                                   TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center" />
                            <Border Grid.Column="1" BackgroundColor="{StaticResource Primary}" WidthRequest="28" HeightRequest="28" StrokeShape="RoundRectangle 14" StrokeThickness="0">
                                <Image Source="fire_icon.png" WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                        </Grid>

                        <controls:RoundedProgressBar 
                            Progress="{Binding CaloriesProgress}" 
                            TrackColor="#1A1A1A"
                            ProgressColor="{StaticResource Primary}"
                            HeightRequest="24" />

                        <Grid ColumnDefinitions="Auto,*">
                            <Border Background="{StaticResource PrimaryBrush}" Padding="8,4" StrokeShape="RoundRectangle 10" StrokeThickness="0">
                                <Label Text="{Binding CaloriesProgress, StringFormat='{0:P0}'}" FontSize="12" FontAttributes="Bold" TextColor="#000000"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End" VerticalOptions="Center">
                                <Label FontSize="14" HorizontalOptions="End">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding NetCalories, StringFormat='{0:F0} '}" TextColor="{StaticResource TextPrimary}" FontAttributes="Bold" />
                                            <Span Text="{Binding UserProfile.Bju.Calories, StringFormat='/ {0:F0} ккал'}" TextColor="{StaticResource TextSecondary}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label Text="{Binding StepCaloriesBurned, StringFormat='−{0:F0} ккал з кроків'}"
                                       FontSize="11"
                                       TextColor="{StaticResource TextSecondary}"
                                       HorizontalOptions="End"
                                       IsVisible="{Binding ShowStepsTile}" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Weekly Chart -->
                        <HorizontalStackLayout Spacing="8" 
                                               HorizontalOptions="Center" 
                                               BindableLayout.ItemsSource="{Binding WeeklyStats}"
                                               HeightRequest="110"
                                               Margin="0,16,0,0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:DailyStatItem">
                                    <VerticalStackLayout Spacing="6" VerticalOptions="End" WidthRequest="32">
                                        
                                        <!-- Value Bubble for Today -->
                                        <Border IsVisible="{Binding IsToday}"
                                                BackgroundColor="White"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 8"
                                                Padding="4,2"
                                                HorizontalOptions="Center"
                                                Margin="0,0,0,-2">
                                            <Label Text="{Binding Value, StringFormat='{0:F0}'}" 
                                                   FontSize="9" 
                                                   FontAttributes="Bold" 
                                                   TextColor="Black" 
                                                   HorizontalOptions="Center"/>
                                        </Border>
                                        
                                        <!-- Empty space if not today to keep alignment -->
                                        <BoxView IsVisible="{Binding IsToday, Converter={StaticResource InvertedBoolConverter}}"
                                                 HeightRequest="15" Color="Transparent"/>

                                        <!-- Vertical Progress Bar -->
                                        <Grid HeightRequest="70" WidthRequest="18" VerticalOptions="End" HorizontalOptions="Center">
                                            <!-- Track background (gray/olive) -->
                                            <Border Background="#1E2019" StrokeThickness="0" StrokeShape="RoundRectangle 9" />
                                            <!-- Fill foreground (green) -->
                                            <Border HeightRequest="{Binding BarHeight}" 
                                                    VerticalOptions="End" 
                                                    StrokeThickness="0" 
                                                    StrokeShape="RoundRectangle 9">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <!-- Past days: darker solid green -->
                                                        <Setter Property="Background" Value="#7A9900" />
                                                        <Style.Triggers>
                                                            <!-- Today: bright green -->
                                                            <DataTrigger TargetType="Border" Binding="{Binding IsToday}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Grid>

                                        <!-- Day Label -->
                                        <Label Text="{Binding Day}" 
                                               FontSize="10" 
                                               TextColor="{StaticResource TextSecondary}"
                                               HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                        
                    </VerticalStackLayout>
                </Border>

                <Label Text="Аналітика"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}"
                       Margin="0,10,0,0"/>

                <!-- 2x2 Grid for BJU -->
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" RowSpacing="12" ColumnSpacing="12">
                    
                    <!-- Protein -->
                    <Border Style="{StaticResource ActiveGlowBorder}" Padding="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Білки" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                                <Label Text="{Binding DailySummary.TotalProtein, StringFormat='{0:F0}'}" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                <Label Text="{Binding UserProfile.Bju.Proteins, StringFormat='з {0:F0} г'}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Grid Grid.Column="1" WidthRequest="48" HeightRequest="48" VerticalOptions="Center">
                                <controls:CircularProgressBar
                                    Progress="{Binding ProteinProgress}"
                                    TrackColor="#1A1A1A"
                                    ProgressColor="{StaticResource Primary}"
                                    Thickness="5" />
                                <Image Source="proteins_icon.png" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Fat -->
                    <Border Grid.Column="1" Style="{StaticResource ActiveGlowBorder}" Padding="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Жири" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                                <Label Text="{Binding DailySummary.TotalFat, StringFormat='{0:F0}'}" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                <Label Text="{Binding UserProfile.Bju.Fats, StringFormat='з {0:F0} г'}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Grid Grid.Column="1" WidthRequest="48" HeightRequest="48" VerticalOptions="Center">
                                <controls:CircularProgressBar
                                    Progress="{Binding FatProgress}"
                                    TrackColor="#1A1A1A"
                                    ProgressColor="{StaticResource Primary}"
                                    Thickness="5" />
                                <Image Source="pizza_icon.png" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Carbs -->
                    <Border Grid.Row="1" Grid.ColumnSpan="{Binding CarbsColumnSpan}" Style="{StaticResource ActiveGlowBorder}" Padding="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Вуглеводи" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                                <Label Text="{Binding DailySummary.TotalCarbs, StringFormat='{0:F0}'}" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                <Label Text="{Binding UserProfile.Bju.Carbs, StringFormat='з {0:F0} г'}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Grid Grid.Column="1" WidthRequest="48" HeightRequest="48" VerticalOptions="Center">
                                <controls:CircularProgressBar
                                    Progress="{Binding CarbsProgress}"
                                    TrackColor="#1A1A1A"
                                    ProgressColor="{StaticResource Primary}"
                                    Thickness="5" />
                                <Image Source="bread_icon.png" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Steps (Android) -->
                    <Border Grid.Row="1" Grid.Column="1"
                            Style="{StaticResource ActiveGlowBorder}"
                            Padding="16"
                            IsVisible="{Binding ShowStepsTile}">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Кроки" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                                <Label Text="{Binding TodaySteps, StringFormat='{0:N0}'}" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                <Label Text="{Binding StepCaloriesBurned, StringFormat='−{0:F0} ккал'}" FontSize="12" TextColor="{StaticResource Primary}" />
                            </VerticalStackLayout>
                            <Grid Grid.Column="1" WidthRequest="48" HeightRequest="48" VerticalOptions="Center">
                                <controls:CircularProgressBar
                                    Progress="{Binding StepsProgress}"
                                    TrackColor="#1A1A1A"
                                    ProgressColor="{StaticResource Primary}"
                                    Thickness="5" />
                                <Image Source="sneaker_icon.png" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Action Buttons -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,10,0,20">
                    <Button Text="Мій раціон"
                            ImageSource="my_ration.png"
                            ContentLayout="Right, 8"
                            Style="{StaticResource LimeButton}"
                            Command="{Binding GoToMyRationCommand}" />
                    <Button Grid.Column="1"
                            Text="Рецепти"
                            ImageSource="receipt.png"
                            ContentLayout="Right, 8"
                            Style="{StaticResource AccentButton}"
                            Command="{Binding GoToMealPlanCommand}" />
                </Grid>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
