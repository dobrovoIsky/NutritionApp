<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:NutritionApp.ViewModels"
             xmlns:models="clr-namespace:NutritionApp.Models"
             x:DataType="viewModels:HistoryViewModel"
             x:Class="NutritionApp.Views.HistoryPage"
             x:Name="HistoryPageRef"
             Shell.NavBarIsVisible="False"
             Background="{StaticResource PageBackgroundGradient}">

    <Grid RowDefinitions="180,*" Padding="0">

        <!-- Верхній блок з градієнтом -->
        <Grid Row="0" Padding="0,16,0,16">


            <VerticalStackLayout Spacing="10"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center">
                <Label Text="📋" FontSize="40" HorizontalOptions="Center"/>
                <Label Text="Історія раціонів"
                       FontAttributes="Bold"
                       FontSize="24"
                       TextColor="White"
                       HorizontalOptions="Center"/>
                <Label Text="Твої збережені плани харчування"
                       FontSize="14"
                       TextColor="#FFEFF2"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Grid>

        <!-- Контент -->
        <Border Grid.Row="1"
                BackgroundColor="{StaticResource CardBackground}"
                Stroke="{StaticResource BorderColor}"
                StrokeThickness="1"
                Padding="16"
                Margin="16,-32,16,16"
                StrokeShape="RoundRectangle 24">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,4" Radius="20" Opacity="0.08" />
            </Border.Shadow>

            <Grid RowDefinitions="Auto,Auto,*">

                <!-- Tabs -->
                <Grid Grid.Row="0" ColumnDefinitions="*,*" Padding="0,0,0,16" ColumnSpacing="12">
                     <Border StrokeShape="RoundRectangle 12" 
                             Stroke="Transparent"
                             Padding="12"
                             HorizontalOptions="Fill">
                         <Border.Style>
                             <Style TargetType="Border">
                                 <Setter Property="BackgroundColor" Value="Transparent"/>
                                 <Style.Triggers>
                                     <DataTrigger TargetType="Border" Binding="{Binding IsMealPlanTab}" Value="True">
                                         <Setter Property="BackgroundColor" Value="#1E3A8A"/>
                                     </DataTrigger>
                                 </Style.Triggers>
                             </Style>
                         </Border.Style>
                         <Border.GestureRecognizers>
                             <TapGestureRecognizer Command="{Binding SwitchTabCommand}" CommandParameter="MealPlan"/>
                         </Border.GestureRecognizers>
                         <Label Text="Раціон" 
                                HorizontalOptions="Center" 
                                FontAttributes="Bold">
                             <Label.Style>
                                 <Style TargetType="Label">
                                     <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
                                     <Style.Triggers>
                                         <DataTrigger TargetType="Label" Binding="{Binding IsMealPlanTab}" Value="True">
                                             <Setter Property="TextColor" Value="{StaticResource Primary}"/>
                                         </DataTrigger>
                                     </Style.Triggers>
                                 </Style>
                             </Label.Style>
                         </Label>
                     </Border>
                     
                     <Border Grid.Column="1"
                             StrokeShape="RoundRectangle 12" 
                             Stroke="Transparent"
                             Padding="12"
                             HorizontalOptions="Fill">
                         <Border.Style>
                             <Style TargetType="Border">
                                 <Setter Property="BackgroundColor" Value="Transparent"/>
                                 <Style.Triggers>
                                     <DataTrigger TargetType="Border" Binding="{Binding IsWorkoutTab}" Value="True">
                                         <Setter Property="BackgroundColor" Value="#4C1D95"/>
                                     </DataTrigger>
                                 </Style.Triggers>
                             </Style>
                         </Border.Style>
                         <Border.GestureRecognizers>
                             <TapGestureRecognizer Command="{Binding SwitchTabCommand}" CommandParameter="Workout"/>
                         </Border.GestureRecognizers>
                         <Label Text="Тренування" 
                                HorizontalOptions="Center" 
                                FontAttributes="Bold">
                             <Label.Style>
                                 <Style TargetType="Label">
                                     <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
                                     <Style.Triggers>
                                         <DataTrigger TargetType="Label" Binding="{Binding IsWorkoutTab}" Value="True">
                                             <Setter Property="TextColor" Value="#7C3AED"/>
                                         </DataTrigger>
                                     </Style.Triggers>
                                 </Style>
                             </Label.Style>
                         </Label>
                     </Border>
                </Grid>

                <!-- Фільтр вибраних та Індикатор завантаження -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,10" IsVisible="{Binding IsMealPlanTab}">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Switch IsToggled="{Binding ShowFavoritesOnly}" OnColor="{StaticResource Primary}" />
                        <Label Text="Тільки вибрані ⭐" VerticalOptions="Center" TextColor="{StaticResource TextSecondary}" FontSize="14" />
                    </HorizontalStackLayout>
                    <ActivityIndicator Grid.Column="1"
                                       IsVisible="{Binding IsLoading}" 
                                       IsRunning="{Binding IsLoading}" 
                                       Color="{StaticResource Primary}"
                                       VerticalOptions="Center" />
                </Grid>

                <!-- Список раціонів -->
                <CollectionView Grid.Row="2" 
                                ItemsSource="{Binding FilteredMealPlans}" 
                                IsVisible="{Binding IsMealPlanTab}"
                                SelectionMode="None">

                    <!-- Порожній стан -->
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Spacing="16"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center"
                                             Margin="0,60,0,0">
                            <Label Text="📭" FontSize="60" HorizontalOptions="Center"/>
                            <Label Text="Немає раціонів"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   HorizontalOptions="Center"/>
                            <Label Text="Згенеруй новий план або зміни фільтр!"
                                   FontSize="14"
                                   TextColor="{StaticResource TextSecondary}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:MealPlan">
                            <Border Stroke="{StaticResource BorderColor}"
                                    BackgroundColor="{StaticResource CardBackground}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="16"
                                    Margin="0,0,0,12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:HistoryViewModel}}, Path=ViewPlanDetailsCommand}"
                                                          CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">

                                    <!-- Іконка -->
                                    <Border WidthRequest="50" 
                                            HeightRequest="50"
                                            StrokeShape="RoundRectangle 25"
                                            BackgroundColor="#1E3A8A"
                                            Stroke="Transparent"
                                            VerticalOptions="Center">
                                        <Label Text="🍽️" 
                                               FontSize="22" 
                                               VerticalOptions="Center" 
                                               HorizontalOptions="Center"/>
                                    </Border>

                                    <!-- Інформація -->
                                    <VerticalStackLayout Grid.Column="1" 
                                                         Margin="14,0,0,0"
                                                         VerticalOptions="Center"
                                                         Spacing="4">
                                        <Label Text="План харчування"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource TextPrimary}"/>
                                        <Label Text="{Binding Date, StringFormat='{0:dd MMMM yyyy, HH:mm}'}"
                                               FontSize="13"
                                               TextColor="{StaticResource TextSecondary}"/>
                                    </VerticalStackLayout>

                                    <!-- Зірочка (Вибране) -->
                                    <Label Grid.Column="2"
                                           Text="☆"
                                           FontSize="26"
                                           TextColor="{StaticResource TextSecondary}"
                                           VerticalOptions="Center"
                                           Margin="0,0,10,0">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:HistoryViewModel}}, Path=ToggleFavoriteCommand}"
                                                                  CommandParameter="{Binding .}"/>
                                        </Label.GestureRecognizers>
                                        <Label.Style>
                                            <Style TargetType="Label">
                                                <Style.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsFavorite}" Value="True">
                                                        <Setter Property="Text" Value="⭐" />
                                                        <Setter Property="TextColor" Value="#F59E0B" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Label.Style>
                                    </Label>

                                    <!-- Стрілка -->
                                    <Label Grid.Column="3"
                                           Text="›"
                                           FontSize="28"
                                           TextColor="{StaticResource TextSecondary}"
                                           VerticalOptions="Center"
                                           Margin="0,0,4,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Список тренувань -->
                <CollectionView Grid.Row="2" 
                                ItemsSource="{Binding Workouts}" 
                                IsVisible="{Binding IsWorkoutTab}"
                                SelectionMode="None">
                    
                     <!-- Порожній стан -->
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Spacing="16"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center"
                                             Margin="0,60,0,0">
                            <Label Text="🏋️‍♂️" FontSize="60" HorizontalOptions="Center"/>
                            <Label Text="Історія тренувань порожня"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   HorizontalOptions="Center"/>
                            <Label Text="Згенеруй своє перше тренування!"
                                   FontSize="14"
                                   TextColor="{StaticResource TextSecondary}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:WorkoutPlan">
                            <Border Stroke="{StaticResource BorderColor}"
                                    BackgroundColor="{StaticResource CardBackground}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="16"
                                    Margin="0,0,0,12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding BindingContext.ViewWorkoutDetailsCommand, Source={x:Reference HistoryPageRef}}"
                                                          CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <!-- Іконка -->
                                    <Border WidthRequest="50" 
                                            HeightRequest="50"
                                            StrokeShape="RoundRectangle 25"
                                            BackgroundColor="#4C1D95"
                                            Stroke="Transparent"
                                            VerticalOptions="Center">
                                        <Label Text="🏃" 
                                               FontSize="22" 
                                               VerticalOptions="Center" 
                                               HorizontalOptions="Center"/>
                                    </Border>

                                    <!-- Інформація -->
                                    <VerticalStackLayout Grid.Column="1" 
                                                         Margin="14,0,0,0"
                                                         VerticalOptions="Center"
                                                         Spacing="4">
                                        <Label Text="{Binding Goal, TargetNullValue='(Без назви)'}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource TextPrimary}"/>
                                        <Label Text="{Binding CreatedAt, StringFormat='{0:dd MMMM yyyy, HH:mm}'}"
                                               FontSize="13"
                                               TextColor="{StaticResource TextSecondary}"/>
                                        <HorizontalStackLayout Spacing="10">
                                            <Label Text="{Binding DurationMinutes, StringFormat='⏱️ {0} хв'}" FontSize="12" TextColor="#4B5563"/>
                                            <Label Text="{Binding Intensity, StringFormat='⚡ {0}'}" FontSize="12" TextColor="#EA580C"/>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <!-- Стрілка -->
                                    <Label Grid.Column="2"
                                           Text="›"
                                           FontSize="28"
                                           TextColor="{StaticResource TextSecondary}"
                                           VerticalOptions="Center"
                                           Margin="0,0,4,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </Grid>
        </Border>

    </Grid>
</ContentPage>